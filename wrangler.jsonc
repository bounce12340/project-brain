{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-brain",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-21",
  // global_fetch_strictly_public：AI 連接器接受 Client ID Metadata Document 時，對外抓取不走同網域路由（防 SSRF）。
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /mcp、/oauth 與 /.well-known 是 AI 連接器（MCP + OAuth）用的，不能被前端 SPA 接走。
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/email/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-brain-db",
      "database_id": "31e51358-0ace-4f6f-99fd-ba602d8d4509",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "project-brain-files" }],
  // AI 連接器的 OAuth 授權、token 與已連接的工具。
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fd392aa43f9347f0810fe9bcd665e93b" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 1 * * *", "30 0 * * 1", "30 0 1 * *"] },
  "routes": [{ "pattern": "projects.uic-ai.com", "custom_domain": true }],
  "vars": {
    "APP_BASE_URL": "https://projects.uic-ai.com",
    "LLM_BASE_URL": "https://api.deepseek.com/v1",
    "LLM_MODEL": "deepseek-v4-pro",
    "AGENTMAIL_INBOX_ID": "uic_ai@agentmail.to",
    "MAIL_FROM_NAME": "艾爾水晶-專案進度"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
